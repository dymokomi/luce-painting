#prisma 4.0
def package "luce-painting" {
    str owner = "dymokomi"
    str version = "0.1.1"
    str kind = "package"
    str language = "luce-base"
    str description = "The brush engine behind luced-2d: Photoshop-style brushes with dynamics, sampled tips and textures, strokes stamped on the GPU a tile at a time, smudge on a worker, healing, and brush masks."
    str readme = "README.md"

    def export "paint" {
        str module = "luce_painting.paint"
    }

    def export "stroke" {
        str module = "luce_painting.stroke"
    }

    def export "dynamics" {
        str module = "luce_painting.dynamics"
    }

    def export "brush_images" {
        str module = "luce_painting.brush_images"
    }

    def export "brush_mask" {
        str module = "luce_painting.brush_mask"
    }

    def export "mixing" {
        str module = "luce_painting.mixing"
    }

    def export "smudge" {
        str module = "luce_painting.warp"
    }

    def export "heal" {
        str module = "luce_painting.heal"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.4"
        str path = "../luce-std"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.1.17"
        str path = "../luce-gpu"
    }

    def dependency "luce-raster" {
        str owner = "dymokomi"
        str version = "^0.1.1"
        str path = "../luce-raster"
    }

    def dependency "luce-color" {
        str owner = "dymokomi"
        str version = "^0.2.3"
        str path = "../luce-color"
    }

    def dependency "luce-canvas" {
        str owner = "dymokomi"
        str version = "^0.1.22"
        str path = "../luce-canvas"
    }
}
